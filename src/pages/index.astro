---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../lib/knowledge';

const posts = await getCollection('knowledge');
const sorted = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recent = sorted.slice(0, 6);

const counts = new Map<string, number>();
for (const p of posts) {
  const cat = p.slug.split('/')[0];
  counts.set(cat, (counts.get(cat) ?? 0) + 1);
}
---

<Base title="meark-wiki · 个人知识库" description="沉淀学过与搜过的知识" isHome>
  <!-- 简短介绍 -->
  <section class="intro">
    <h1 class="intro-title">meark-wiki</h1>
    <p class="intro-sub">把学过、以及通过 AI 搜索后总结的知识，沉淀成自己的体系。</p>
    <p class="intro-stats">共 {posts.length} 篇文章 · {CATEGORIES.length} 个分类</p>
  </section>

  <!-- 宫格分类卡片 -->
  <section class="section">
    <h2 class="section-title">知识分类</h2>
    <div class="cat-grid">
      {CATEGORIES.map((c) => (
        <a class="cat-card" href={`/knowledge/${c.key}/`}>
          <div class="cat-card-head">
            <span class="cat-card-name">{c.name}</span>
            <span class="cat-card-count">{counts.get(c.key) ?? 0} 篇</span>
          </div>
          <p class="cat-card-desc">{c.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- 最近更新列表 -->
  <section class="section">
    <div class="section-head">
      <h2 class="section-title">最近更新</h2>
      <a class="section-more" href="/knowledge/">查看全部 →</a>
    </div>
    <ul class="recent-list">
      {recent.map((p) => {
        const [cat] = p.slug.split('/');
        const catName = CATEGORIES.find((c) => c.key === cat)?.name ?? cat;
        return (
          <li>
            <a class="recent-item" href={`/knowledge/${p.slug}/`}>
              <span class="recent-date">{p.data.pubDate.toISOString().slice(0, 10)}</span>
              <span class="recent-title">{p.data.title}</span>
              <span class="recent-cat">{catName}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</Base>

<style>
  /* ===== 介绍区 ===== */
  .intro {
    margin-bottom: var(--space-10);
  }
  .intro-title {
    font-size: var(--text-2xl);
    line-height: var(--text-2xl-lh);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }
  .intro-sub {
    font-size: var(--text-md);
    line-height: var(--text-md-lh);
    color: var(--text-secondary);
    margin: 0 0 var(--space-2);
    max-width: 50ch;
  }
  .intro-stats {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--text-tertiary);
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  /* ===== 区块通用 ===== */
  .section {
    margin-bottom: var(--space-10);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
  }
  .section-title {
    font-size: var(--text-md);
    line-height: var(--text-md-lh);
    font-weight: var(--fw-semibold);
    color: var(--text-secondary);
    margin: 0;
  }
  .section-more {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: var(--fw-medium);
    color: var(--brand-6);
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .section-more:hover { color: var(--brand-7); }
  .section-more:focus-visible {
    outline: 2px solid var(--brand-6);
    outline-offset: 2px;
  }

  /* ===== 宫格分类卡片 ===== */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }
  .cat-card {
    background: var(--bg-container);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-xs);
    transition: box-shadow var(--duration-base) var(--ease-standard);
  }
  .cat-card:hover {
    box-shadow: var(--shadow-md);
  }
  .cat-card:focus-visible {
    outline: 2px solid var(--brand-6);
    outline-offset: 2px;
  }
  .cat-card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-2);
  }
  .cat-card-name {
    font-size: var(--text-md);
    line-height: var(--text-md-lh);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
  }
  .cat-card-count {
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  .cat-card-desc {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--text-secondary);
    margin: 0;
  }

  /* ===== 最近更新列表 ===== */
  .recent-list {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--bg-container);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
  }
  .recent-item {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
    transition: background var(--duration-fast) var(--ease-standard);
  }
  .recent-item:last-child { border-bottom: none; }
  .recent-item:hover { background: var(--bg-sunken); }
  .recent-item:focus-visible {
    outline: 2px solid var(--brand-6);
    outline-offset: -2px;
  }
  .recent-date {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  .recent-title {
    font-size: var(--text-base);
    line-height: var(--text-base-lh);
    font-weight: var(--fw-medium);
    color: var(--text-primary);
  }
  .recent-cat {
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
    color: var(--brand-6);
  }

  @media (max-width: 900px) {
    .cat-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .cat-grid { grid-template-columns: 1fr; }
    .recent-item {
      grid-template-columns: 1fr auto;
      gap: var(--space-2);
      padding: var(--space-3) var(--space-4);
    }
    .recent-date { grid-column: 1 / -1; order: 3; }
    .recent-title { order: 1; }
    .recent-cat { order: 2; }
  }
</style>
