---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { CATEGORIES, getCategory } from '../../../lib/knowledge';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.key } }));
}

const { category } = Astro.props;
const info = getCategory(category);

const posts = (await getCollection('knowledge'))
  .filter((p) => p.slug.split('/')[0] === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title={`${info?.name ?? category} · meark-wiki`} activeCategory={category}>
  <section class="page-head">
    <nav class="crumb" aria-label="面包屑">
      <a href="/knowledge/">全部</a>
      <span class="crumb-sep">/</span>
      <span>{info?.name ?? category}</span>
    </nav>
    <h1 class="page-title">{info?.name ?? category}</h1>
    {info && <p class="page-desc">{info.description}</p>}
  </section>

  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <a class="post-item" href={`/knowledge/${category}/${p.slug.split('/').slice(1).join('/')}/`}>
          <span class="post-date">{p.data.pubDate.toISOString().slice(0, 10)}</span>
          <span class="post-title">{p.data.title}</span>
          {p.data.tags.length > 0 && (
            <span class="post-tags">{p.data.tags.map((t) => `#${t}`).join('  ')}</span>
          )}
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .page-head {
    margin-bottom: var(--space-8);
  }
  .crumb {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--text-tertiary);
    margin-bottom: var(--space-3);
  }
  .crumb a {
    color: var(--text-secondary);
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .crumb a:hover { color: var(--text-primary); }
  .crumb-sep { margin: 0 var(--space-2); }
  .page-title {
    font-size: var(--text-2xl);
    line-height: var(--text-2xl-lh);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }
  .page-desc {
    font-size: var(--text-md);
    line-height: var(--text-md-lh);
    color: var(--text-secondary);
    margin: 0;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--bg-container);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
  }
  .post-item {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
    transition: background var(--duration-fast) var(--ease-standard);
  }
  .post-item:last-child { border-bottom: none; }
  .post-item:hover { background: var(--bg-sunken); }
  .post-item:focus-visible {
    outline: 2px solid var(--brand-6);
    outline-offset: -2px;
  }
  .post-date {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  .post-title {
    font-size: var(--text-base);
    line-height: var(--text-base-lh);
    font-weight: var(--fw-medium);
    color: var(--text-primary);
  }
  .post-tags {
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .post-item {
      grid-template-columns: 1fr auto;
      gap: var(--space-2);
      padding: var(--space-3) var(--space-4);
    }
    .post-date { grid-column: 1 / -1; order: 3; }
    .post-title { order: 1; }
    .post-tags { order: 2; }
  }
</style>
