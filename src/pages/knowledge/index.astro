---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORIES } from '../../lib/knowledge';

const posts = await getCollection('knowledge');
const sorted = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const grouped = CATEGORIES.map((c) => ({
  category: c,
  items: sorted.filter((p) => p.slug.split('/')[0] === c.key),
})).filter((g) => g.items.length > 0);
---

<Base title="全部知识 · meark-wiki" activeCategory="">
  <section class="page-head">
    <h1 class="page-title">全部知识</h1>
    <p class="page-desc">共 {sorted.length} 篇，按分类归档。</p>
  </section>

  {grouped.map((g) => (
    <section class="cat-block">
      <div class="cat-head">
        <h2 class="cat-title">{g.category.name}</h2>
        <a class="cat-more" href={`/knowledge/${g.category.key}/`}>分类页 →</a>
      </div>
      <ul class="post-list">
        {g.items.map((p) => (
          <li>
            <a class="post-item" href={`/knowledge/${p.slug}/`}>
              <span class="post-date">{p.data.pubDate.toISOString().slice(0, 10)}</span>
              <span class="post-title">{p.data.title}</span>
              {p.data.tags.length > 0 && (
                <span class="post-tags">{p.data.tags.map((t) => `#${t}`).join('  ')}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .page-head {
    margin-bottom: var(--space-8);
  }
  .page-title {
    font-size: var(--text-2xl);
    line-height: var(--text-2xl-lh);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }
  .page-desc {
    font-size: var(--text-md);
    line-height: var(--text-md-lh);
    color: var(--text-secondary);
    margin: 0;
  }

  .cat-block {
    margin-bottom: var(--space-10);
  }
  .cat-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }
  .cat-title {
    font-size: var(--text-lg);
    line-height: var(--text-lg-lh);
    font-weight: var(--fw-semibold);
    color: var(--text-primary);
    margin: 0;
  }
  .cat-more {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    font-weight: var(--fw-medium);
    color: var(--brand-6);
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .cat-more:hover { color: var(--brand-7); }
  .cat-more:focus-visible {
    outline: 2px solid var(--brand-6);
    outline-offset: 2px;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--bg-container);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
  }
  .post-item {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
    transition: background var(--duration-fast) var(--ease-standard);
  }
  .post-item:last-child { border-bottom: none; }
  .post-item:hover { background: var(--bg-sunken); }
  .post-item:focus-visible {
    outline: 2px solid var(--brand-6);
    outline-offset: -2px;
  }
  .post-date {
    font-size: var(--text-sm);
    line-height: var(--text-sm-lh);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  .post-title {
    font-size: var(--text-base);
    line-height: var(--text-base-lh);
    font-weight: var(--fw-medium);
    color: var(--text-primary);
  }
  .post-tags {
    font-size: var(--text-xs);
    line-height: var(--text-xs-lh);
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .post-item {
      grid-template-columns: 1fr auto;
      gap: var(--space-2);
      padding: var(--space-3) var(--space-4);
    }
    .post-date { grid-column: 1 / -1; order: 3; }
    .post-title { order: 1; }
    .post-tags { order: 2; }
  }
</style>
